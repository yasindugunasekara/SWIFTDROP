# ==============================================================================
# SWIFTDROP SERVER ENVIRONMENT VARIABLES
# ==============================================================================

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Supabase Auth signup/login use only the URL and publishable/anon key above.
# Do not put a service-role or secret key in SUPABASE_ANON_KEY.
APP_URL=http://localhost:3000

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:postgres_password_example@localhost:5432/swiftdrop_db?schema=public
# For Supabase, copy the session pooler URL from Project > Connect into server/.env.

# Optional: no database password? Set DATABASE_DRIVER=supabase to run the same SQL
# through Supabase's HTTPS API with a server-only secret key instead of DATABASE_URL.
# Requires migration 20261118000000_service_role_sql_bridge.sql. Never expose this key
# to web/ or mobile/. Statements are not transactional in this mode (dev only).
# DATABASE_DRIVER=supabase
# SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
# Percent-encode reserved characters in the database password. Never use NEXT_PUBLIC_ for this URL.
# If certificate verification requires your project's CA, paste its PEM with literal \n line breaks:
DATABASE_SSL_CA=

# Redis Connection
REDIS_URL=redis://localhost:6379

# RabbitMQ Connection
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE_NOTIFICATIONS=swiftdrop_notifications_queue
RABBITMQ_QUEUE_WEBHOOKS=swiftdrop_webhooks_queue
RABBITMQ_QUEUE_DLQ=swiftdrop_dead_letter_queue

# Security & JWT (Member 1)
JWT_ACCESS_SECRET=your_jwt_access_secret_super_secure_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_super_secure_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Webhook Signing Secret (Member 8)
WEBHOOK_HMAC_SECRET=your_webhook_hmac_secret_key_minimum_32_chars

# AI API Key (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-1.5-flash

# Proof of delivery uploads (Member 4)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Member 3 live tracking. URL browsers use for the tracking WebSocket served by the
# standalone API (npm run dev / k8s), e.g. ws://localhost:5000/ws/tracking or
# wss://api.example.com/ws/tracking. Leave empty on Vercel: clients then poll.
TRACKING_WS_URL=
# How often (ms) subscribed parcels are checked for status changes.
TRACKING_POLL_MS=3000
