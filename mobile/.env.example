# Browser preview: leave empty to use the preview computer's hostname on port 5000.
# Native physical phone: set http://<computer-LAN-IP>:5000/api/v1 instead.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WS_URL=ws://localhost:5000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Enable after activating the existing-account Before User Created hook in Supabase Auth.
EXPO_PUBLIC_GOOGLE_EXISTING_ONLY_READY=false
